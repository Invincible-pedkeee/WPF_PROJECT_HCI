<Window x:Class="BasketballBallBrandsCMS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Basketball Ball Brands CMS - Login"
        Width="760"
        Height="760"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadowEffect"
                          BlurRadius="25"
                          ShadowDepth="8"
                          Opacity="0.45"
                          Color="Black"/>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#F6E7D8"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
            <Setter Property="BorderBrush" Value="#2E2E2E"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="InputPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#F6E7D8"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
            <Setter Property="BorderBrush" Value="#2E2E2E"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#D86F1D"/>
            <Setter Property="BorderBrush" Value="#1D1D1D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#2B2B2B"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="ValidationTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD6D6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="3,4,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Canvas Width="760" Height="760">
        <Canvas.Resources>
            <DropShadowEffect x:Key="MouseOverEffect"
                              BlurRadius="15"
                              ShadowDepth="4"
                              Opacity="0.45"
                              Color="#FFB36A"/>
        </Canvas.Resources>

        <!-- Glavni shape prozora -->
        <Path x:Name="UIPath"
              Canvas.Left="30"
              Canvas.Top="30"
              
              Stroke="#191919"
              StrokeThickness="12"
              Effect="{StaticResource WindowShadowEffect}">
            <Path.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#F07A22" Offset="0"/>
                    <GradientStop Color="#C65F18" Offset="1"/>
                </RadialGradientBrush>
            </Path.Fill>
            <Path.Data>
                
                <EllipseGeometry Center="350,350" RadiusX="350" RadiusY="350"/>
            </Path.Data>
        </Path>

        <!-- Glavne krive (Molten stil) -->

        <!-- Gornja zakrivljena linija -->
        <Path Canvas.Left="30"
      Canvas.Top="30"
      Stroke="#0F0F0F"
      StrokeThickness="8"
      StrokeStartLineCap="Round"
      StrokeEndLineCap="Round"
      Data="M 12 260 C 200 200, 500 200, 690 260" />

        <!-- Donja zakrivljena linija -->
        <Path Canvas.Left="30"
      Canvas.Top="30"
      Stroke="#0F0F0F"
      StrokeThickness="8"
      StrokeStartLineCap="Round"
      StrokeEndLineCap="Round"
      Data="M 12 440 C 200 500, 500 500, 690 440" />

        <!-- Centralna vertikalna -->
        <Path Canvas.Left="30"
      Canvas.Top="30"
      Stroke="#0F0F0F"
      StrokeThickness="8"
      StrokeStartLineCap="Round"
      StrokeEndLineCap="Round"
      Data="M 350 0 C 320 200, 320 500, 350 700" />

        <!-- Desna zakrivljena -->
        <Path Canvas.Left="30"
      Canvas.Top="30"
      Stroke="#0F0F0F"
      StrokeThickness="8"
      StrokeStartLineCap="Round"
      StrokeEndLineCap="Round"
      Data="M 500 35 C 600 250, 600 450, 500 664" />

        <!-- Lijeva zakrivljena -->
        <Path Canvas.Left="30"
      Canvas.Top="30"
      Stroke="#0F0F0F"
      StrokeThickness="8"
      StrokeStartLineCap="Round"
      StrokeEndLineCap="Round"
      Data="M 200 40 C 100 250, 100 450, 200 660" />

        <TextBlock Canvas.Left="255"
                   Canvas.Top="90"
                   Text="BASKETBALL CMS"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="Bold"/>

        <TextBlock Canvas.Left="225"
                   Canvas.Top="130"
                   Width="310"
                   Text="Login window designed in the style of Exercise 3"
                   TextAlignment="Center"
                   Foreground="#FFF2E8"
                   FontSize="14"/>

         
        <Border Canvas.Left="190"
                Canvas.Top="210"
                Width="380"
                Height="320"
                Background="#66000000"
                CornerRadius="26"
                BorderBrush="#F4D3B2"
                BorderThickness="1.2">
            <StackPanel Margin="28">
                <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}"/>

                <TextBox x:Name="UsernameTextBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         ToolTip="Enter your username"/>

                <TextBlock x:Name="UsernameErrorTextBlock"
                           Style="{StaticResource ValidationTextStyle}"/>

                <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}"/>

                <PasswordBox x:Name="PasswordInput"
                             Style="{StaticResource InputPasswordBoxStyle}"
                             ToolTip="Enter your password"/>

                <TextBlock x:Name="PasswordErrorTextBlock"
                           Style="{StaticResource ValidationTextStyle}"/>

                <TextBlock x:Name="LoginStatusTextBlock"
                           Foreground="#FFE5E5"
                           FontSize="13"
                           Margin="0,10,0,0"
                           TextAlignment="Center"
                           Visibility="Collapsed"/>

                <Button x:Name="LoginButton"
                        Content="Login"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Complete login"
                        Click="LoginButton_Click"/>

                <Button x:Name="ExitButton"
                        Content="Exit"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Exit application"
                        Click="ExitButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Donji info panel -->
        <Border Canvas.Left="215"
                Canvas.Top="560"
                Width="330"
                Height="95"
                Background="#4A1F00"
                CornerRadius="18"
                BorderBrush="#F4D3B2"
                BorderThickness="1">
            <StackPanel Margin="18">
                <TextBlock Text="Demo accounts"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Admin: admin / admin123"
                           Foreground="#FFF0E3"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Visitor: pelemaradona / peroperic2004"
                           Foreground="#FFF0E3"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

         
    </Canvas>
</Window>