<Window x:Class="BasketballBallBrandsCMS.Views.AddEditBrandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Add / Edit Brand"
        Width="820" Height="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#F6E7D8"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
            <Setter Property="BorderBrush" Value="#D86F1D"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style x:Key="ErrorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8080"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,2,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>
        <Style x:Key="RtfToolButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="#1A1A1A" BorderBrush="#D86F1D" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Border Grid.Row="0" Background="#D86F1D" CornerRadius="16,16,0,0">
                <Grid>
                    <TextBlock x:Name="WindowTitleTextBlock"
                               Text="Add New Brand"
                               Foreground="White" FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="20,0"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0" Width="28" Height="28"
                            FontWeight="Bold" Foreground="White"
                            Background="#B85C10" BorderBrush="Transparent"
                            Cursor="Hand" Click="CancelButton_Click"/>
                </Grid>
            </Border>

             
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25,10,25,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                     
                    <StackPanel Grid.Column="0">

                         
                        <TextBlock Text="Brand Name *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="BrandNameTextBox" Style="{StaticResource InputStyle}"
                                 ToolTip="Enter the brand name (e.g. Wilson, Spalding)"
                                 TextChanged="BrandNameTextBox_TextChanged"/>
                        <TextBlock x:Name="BrandNameError" Text="Brand name is required."
                                   Style="{StaticResource ErrorStyle}"/>

                         
                        <TextBlock Text="Brand ID (number) *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="BrandIdTextBox" Style="{StaticResource InputStyle}"
                                 ToolTip="Enter a unique numeric ID for this brand"
                                 PreviewTextInput="NumberOnly_PreviewTextInput"/>
                        <TextBlock x:Name="BrandIdError" Text="Brand ID must be a valid number."
                                   Style="{StaticResource ErrorStyle}"/>

                        
                        <TextBlock Text="Image *" Style="{StaticResource LabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="ImagePathTextBox" Style="{StaticResource InputStyle}"
                                     IsReadOnly="True" Width="320"
                                     ToolTip="Path to the brand's image"/>
                            <Button Content="Browse..."
                                    Height="36" Margin="8,0,0,0" Padding="12,0"
                                    FontSize="12" Cursor="Hand"
                                    Background="#D86F1D" Foreground="White"
                                    BorderBrush="#B85C10" BorderThickness="1"
                                    ToolTip="Select an image from your computer"
                                    Click="BrowseImageButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ImageError" Text="Please select an image."
                                   Style="{StaticResource ErrorStyle}"/>


                        <TextBlock Text="Import RTF File (optional)" Style="{StaticResource LabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="RtfPathTextBox" Style="{StaticResource InputStyle}"
                                     IsReadOnly="True" Width="320"
                                     ToolTip="Path to the associated .rtf document"/>
                            <Button Content="Browse..."
                                    Height="36" Margin="8,0,0,0" Padding="12,0"
                                    FontSize="12" Cursor="Hand"
                                    Background="#2B2B2B" Foreground="White"
                                    BorderBrush="#555" BorderThickness="1"
                                    ToolTip="Select an RTF file from your computer"
                                    Click="BrowseRtfButton_Click"/>
                        </StackPanel>


                        <TextBlock Text="Description (RTF Editor) *" Style="{StaticResource LabelStyle}"/>


                        <Border Background="#2B2B2B" CornerRadius="4,4,0,0" Padding="6,4">
                            <WrapPanel Orientation="Horizontal">
                                <!-- Bold -->
                                <ToggleButton x:Name="BoldToggle"
              Style="{StaticResource RtfToolButton}"
              ToolTip="Bold (Ctrl+B)"
              Click="BoldToggle_Click">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DD;" FontSize="14" FontWeight="Normal"/>
                                </ToggleButton>

                                <!-- Italic -->
                                <ToggleButton x:Name="ItalicToggle"
              Style="{StaticResource RtfToolButton}"
              ToolTip="Italic (Ctrl+I)"
              Click="ItalicToggle_Click">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DB;" FontSize="14"/>
                                </ToggleButton>

                                <!-- Underline -->
                                <ToggleButton x:Name="UnderlineToggle"
                              Style="{StaticResource RtfToolButton}"
                              ToolTip="Underline (Ctrl+U)"
                              Click="UnderlineToggle_Click">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DC;" FontSize="14"/>
                                </ToggleButton>

                                <Separator Width="1" Background="#555" Margin="6,2"/>

                                 
                                <ComboBox x:Name="FontFamilyComboBox"
                                          Width="130" Height="28" Margin="2,0"
                                          ToolTip="Select font"
                                          SelectionChanged="FontFamilyComboBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Source}"
                                                       FontFamily="{Binding}"
                                                       FontSize="13"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                 
                                <ComboBox x:Name="FontSizeComboBox"
                                          Width="58" Height="28" Margin="4,0"
                                          ToolTip="Select font size"
                                          SelectionChanged="FontSizeComboBox_SelectionChanged"/>

                                <Separator Width="1" Background="#555" Margin="6,2"/>

                                 
                                <ComboBox x:Name="FontColorComboBox"
                                          Width="110" Height="28" Margin="2,0"
                                          ToolTip="Select text color"
                                          SelectionChanged="FontColorComboBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="16" Height="16" Margin="0,0,6,0"
                                                        Background="{Binding Name}"
                                                        BorderBrush="#333" BorderThickness="1"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </WrapPanel>
                        </Border>

                         
                        <RichTextBox x:Name="DescriptionRichTextBox"
                                     Height="140"
                                     Background="#F6E7D8"
                                     Foreground="#1F1F1F"
                                     FontSize="13"
                                     Padding="8"
                                     BorderBrush="#D86F1D"
                                     BorderThickness="1.5,0,1.5,1.5"
                                     ToolTip="Enter brand description using the formatting tools above"
                                     SelectionChanged="DescriptionRichTextBox_SelectionChanged"
                                     KeyUp="DescriptionRichTextBox_KeyUp"/>

                         
                        <Border Background="#2B2B2B" CornerRadius="0,0,4,4" Padding="8,3">
                            <TextBlock x:Name="WordCountTextBlock"
                                       Text="Words: 0"
                                       Foreground="#AAA"
                                       FontSize="11"/>
                        </Border>
                        <TextBlock x:Name="DescriptionError" Text="Description is required."
                                   Style="{StaticResource ErrorStyle}"/>

                    </StackPanel>

                     
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,32,0,0">
                        <TextBlock Text="Image Preview" Foreground="#AAA" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <Border Width="190" Height="160"
                                Background="#2B2B2B" CornerRadius="8"
                                BorderBrush="#D86F1D" BorderThickness="1.5">
                            <Image x:Name="ImagePreview"
                                   Stretch="Uniform"
                                   Margin="6"
                                   ToolTip="Preview of selected image"/>
                        </Border>
                        <TextBlock Text="(No image selected)"
                                   x:Name="NoImageLabel"
                                   Foreground="#888" FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

             
            <Border Grid.Row="2" Background="#242424" CornerRadius="0,0,16,16" Padding="20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SaveButton"
                            Content="💾  Save"
                            Style="{StaticResource ActionButton}"
                            Background="#D86F1D" BorderBrush="#B85C10"
                            Margin="0,0,10,0"
                            ToolTip="Save this brand"
                            Click="SaveButton_Click"/>
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Style="{StaticResource ActionButton}"
                            Background="#3A3A3A" BorderBrush="#555"
                            ToolTip="Cancel and discard changes"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
