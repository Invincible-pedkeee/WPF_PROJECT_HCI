<Window x:Class="BasketballBallBrandsCMS.Views.BrandDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Brand Details"
        Width="620" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="18" Background="#1A1A1A" BorderBrush="#D86F1D" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#D86F1D" CornerRadius="16,16,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                        <TextBlock Text="🏀" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Brand Details" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0" Width="28" Height="28"
                            FontWeight="Bold" Foreground="White"
                            Background="#B85C10" BorderBrush="Transparent"
                            Cursor="Hand" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: details -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">

                        <TextBlock Text="Brand Name" Foreground="#AAA" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BrandNameText" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,2,0,14"/>

                        <TextBlock Text="Brand ID" Foreground="#AAA" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BrandIdText" Foreground="#D86F1D" FontSize="16" Margin="0,2,0,14"/>

                        <TextBlock Text="Date Added" Foreground="#AAA" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DateAddedText" Foreground="#CCC" FontSize="14" Margin="0,2,0,14"/>

                        <Separator Background="#333" Margin="0,4,0,12"/>

                        <TextBlock Text="Description" Foreground="#AAA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <!-- FlowDocumentScrollViewer — displays RTF content, no editable controls visible -->
                        <Border Background="#2B2B2B" CornerRadius="6"
                                BorderBrush="#444" BorderThickness="1"
                                MinHeight="140" MaxHeight="220" Padding="2">
                            <FlowDocumentScrollViewer x:Name="DescriptionViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Background="Transparent"
                                                      Foreground="White"
                                                      FontSize="13"
                                                      IsSelectionEnabled="False"/>
                        </Border>
                    </StackPanel>

                    <!-- Right: image -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock Text="Image" Foreground="#AAA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <Border Margin="0,4,0,0" Width="160" Height="140"
                                Background="#2B2B2B" CornerRadius="8"
                                BorderBrush="#D86F1D" BorderThickness="1.5">
                            <Image x:Name="BrandImage" Stretch="Uniform" Margin="6"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#242424" CornerRadius="0,0,16,16" Padding="20,0">
                <Button Content="Close"
                        HorizontalAlignment="Right"
                        Height="34" Padding="20,0"
                        FontSize="13" FontWeight="SemiBold"
                        Foreground="White"
                        Background="#2B2B2B" BorderBrush="#555"
                        Cursor="Hand"
                        ToolTip="Close this window"
                        Click="CloseButton_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
