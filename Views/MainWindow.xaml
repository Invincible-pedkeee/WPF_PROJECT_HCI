<Window x:Class="BasketballBallBrandsCMS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Basketball CMS - Main"
        Width="1100" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="20" ShadowDepth="6" Opacity="0.4" Color="Black"/>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#D86F1D"/>
            <Setter Property="BorderBrush" Value="#1D1D1D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Background" Value="#B03A2E"/>
        </Style>

        <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Background" Value="#2B2B2B"/>
        </Style>

        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFF6EE"/>
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4D3B2"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F4D3B2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Effect="{StaticResource WindowShadow}">
        <Border CornerRadius="18" Background="#1A1A1A" BorderBrush="#D86F1D" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="45"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#D86F1D" CornerRadius="16,16,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                            <TextBlock Text="🏀" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="BASKETBALL CMS" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LoggedUserTextBlock"
                                       Foreground="#FFE5CC"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="20,0,0,0"/>
                        </StackPanel>

                        <Button x:Name="CloseButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,15,0"
                                Width="32"
                                Height="32"
                                Content="✕"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#B85C10"
                                BorderBrush="Transparent"
                                Cursor="Hand"
                                ToolTip="Close application"
                                Click="CloseButton_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#2B2B2B" Padding="15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AddButton"
                                Content="➕  Add Brand"
                                Style="{StaticResource HeaderButtonStyle}"
                                ToolTip="Add a new basketball ball brand"
                                Click="AddButton_Click"/>

                        <Button x:Name="DeleteButton"
                                Content="🗑  Delete Selected"
                                Style="{StaticResource DangerButtonStyle}"
                                ToolTip="Delete all checked brands"
                                Click="DeleteButton_Click"/>

                        <Separator Background="#555" Width="1" Margin="10,8"/>

                        <Button x:Name="LogoutButton"
                                Content="🚪  Logout"
                                Style="{StaticResource ExitButtonStyle}"
                                ToolTip="Return to login screen"
                                Click="LogoutButton_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#F9F0E8" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#E8D5C0" Padding="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="SelectAllCheckBox"
                                          Content="Select All"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="#4A2800"
                                          Cursor="Hand"
                                          ToolTip="Check to select all rows for deletion"
                                          Checked="SelectAllCheckBox_Checked"
                                          Unchecked="SelectAllCheckBox_Unchecked"/>
                                <TextBlock x:Name="ItemCountTextBlock"
                                           Foreground="#7A4A20"
                                           FontSize="12"
                                           Margin="20,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  x:Name="BrandsDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="False"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E0C8A8"
                                  Background="#F9F0E8"
                                  RowBackground="#FFF6EE"
                                  AlternatingRowBackground="#FFF0E2"
                                  BorderThickness="0"
                                  ColumnHeaderHeight="38"
                                  RowHeight="70"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  RowStyle="{StaticResource DataGridRowStyle}">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#D86F1D"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="BorderBrush" Value="#B85C10"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select" Width="0.8*" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox x:Name="RowCheckBox"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Cursor="Hand"
                                                      ToolTip="Check to mark for deletion"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Brand Name" Width="2.4*" SortMemberPath="BrandName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Padding="6,0">
                                                <Hyperlink x:Name="BrandHyperlink"
                                                           NavigateUri="#"
                                                           Foreground="#D86F1D"
                                                           Click="BrandHyperlink_Click"
                                                           ToolTip="Click to view or edit this brand">
                                                    <Run Text="{Binding BrandName}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Image" Width="1.4*" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F3E6D9"
                                                    CornerRadius="8"
                                                    Padding="4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding SafeImagePath}"
                                                       Width="70"
                                                       Height="50"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding BrandName}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Date Added" Width="1.8*" SortMemberPath="DateAdded">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DateAdded, StringFormat='dd.MM.yyyy HH:mm'}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Padding="6,0"
                                                       FontSize="13"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Brand ID" Width="1*" SortMemberPath="Id">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Id}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Padding="6,0"
                                                       FontSize="13"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="#1A1A1A" CornerRadius="0,0,16,16" Padding="15,0">
                    <TextBlock x:Name="StatusBarTextBlock"
                               Foreground="#AAA"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="Ready."/>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>